// 구조물(문/기지) 피격 표시용 이펙트.
//   pass 0 : 아웃라인(실루엣) 패스 — 메시를 법선 방향으로 부풀린 껍데기를 그리고 앞면을 컬링해
//            테두리만 남긴다. 수식/상수(0.001 스케일)는 엔진 내장 builtin-toon.effect의
//            silhouette-edge 패스와 동일하게 맞췄다.
//   pass 1 : 본체 패스 — 원래 텍스처 색과 지정한 단색을 mixFactor로 블렌딩한다.
//            (mixFactor 1 = 완전 단색, 0 = 원래 색 그대로)
//
// builtin-toon을 그대로 포크하지 않은 이유: 3.8.8에서 "surfaces" 청크 기반 이펙트는 커스텀
// 에셋으로 등록되는 순간 GLSL 컴파일에 실패한다(엔진 버그, FollowerGhost.effect 작업 때 확인).
// 그래서 이 프로젝트에서 커스텀 에셋으로 정상 컴파일되는 게 확인된 legacy/unlit 계열로 짜되,
// 스키닝 메시도 지원해야 하므로 정점 입력만 legacy/input-standard를 쓴다.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: outline-vs:vert
      frag: outline-fs:frag
      rasterizerState:
        cullMode: front
      depthStencilState:
        depthFunc: less_equal
        depthTest: true
        depthWrite: true
      properties:
        outlineColor: { value: [1.0, 0.0, 0.0, 1.0], linear: true, editor: { displayName: OutlineColor, type: color } }
        lineWidth:    { value: 10.0, target: outlineParams.x, editor: { displayName: OutlineWidth, range: [0, 200], slide: true } }
    - vert: main-vs:vert
      frag: main-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: true
      properties:
        mainTexture:  { value: grey }
        tilingOffset: { value: [1.0, 1.0, 0.0, 0.0] }
        mainColor:    { value: [1.0, 1.0, 1.0, 1.0], linear: true, editor: { type: color } }
        blendColor:   { value: [1.0, 0.0, 0.0, 1.0], linear: true, editor: { displayName: BlendColor, type: color } }
        mixFactor:    { value: 0.6, target: mixParams.x, editor: { displayName: MixFactor, range: [0, 1], slide: true } }
}%

CCProgram outline-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  uniform OutlineVert {
    vec4 outlineParams; // x: lineWidth
  };

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    // 로컬 공간에서 법선 방향으로 부풀린다 — 오브젝트 스케일을 따라가므로 내장 toon과 동일하게
    // 동작한다. 0.001 배율도 내장 구현과 동일(그래서 lineWidth 기본값이 10 단위다).
    vec3 localPos = In.position.xyz + normalize(In.normal) * (outlineParams.x * 0.001);
    vec4 worldPos = matWorld * vec4(localPos, 1.0);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram outline-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>

  uniform OutlineFrag {
    vec4 outlineColor;
  };

  vec4 frag () {
    // linear: true로 선언한 프로퍼티는 이미 선형 색으로 들어오므로 변환하지 않는다.
    return CCFragOutput(outlineColor);
  }
}%

CCProgram main-vs %{
  precision highp float;
  #include <legacy/input-standard>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>
  #include <legacy/fog-vs>

  out vec2 v_uv;

  uniform TexCoords {
    vec4 tilingOffset;
  };

  vec4 vert () {
    StandardVertInput In;
    CCVertInput(In);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    vec4 worldPos = matWorld * In.position;
    v_uv = a_texCoord * tilingOffset.xy + tilingOffset.zw;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(v_uv);
    #endif

    CC_TRANSFER_FOG(worldPos);
    return cc_matProj * (cc_matView * worldPos);
  }
}%

CCProgram main-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <legacy/output-standard>
  #include <legacy/fog-fs>

  in vec2 v_uv;

  uniform sampler2D mainTexture;

  uniform MainConstant {
    vec4 mainColor;
    vec4 blendColor;
    vec4 mixParams; // x: mixFactor
  };

  vec4 frag () {
    vec4 texColor = texture(mainTexture, v_uv);
    texColor.rgb = SRGBToLinear(texColor.rgb);
    vec4 o = mainColor * texColor;

    o.rgb = mix(o.rgb, blendColor.rgb, clamp(mixParams.x, 0.0, 1.0));

    CC_APPLY_FOG(o);
    return CCFragOutput(o);
  }
}%
